<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hisho.codex-discord-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__BOT_DIR__/bot.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BOT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- ログイン時に自動起動する -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 落ちても自動で立ち上げ直す（常駐を維持） -->
    <key>KeepAlive</key>
    <true/>

    <!-- 連続クラッシュ時に暴走しないよう最低10秒あける -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- 標準出力・エラーとも同じログファイルにまとめる -->
    <key>StandardOutPath</key>
    <string>__BOT_DIR__/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__BOT_DIR__/bot.log</string>
</dict>
</plist>

# Discordボット(codex版)の設定。実際の値は .env にコピーして記入する。
# この値は秘密なので絶対に他人に共有しない・SNSやスクショに写さない。

# codex用に新規作成したDiscordアプリ「Bot」タブのトークン（アプリID 1541825962851835934）
DISCORD_TOKEN=ここにトークンを貼る

# 応答を許可する持ち主のDiscordユーザーID。AUTO にすると最初に話しかけた人を自動登録する
ALLOWED_USER_ID=AUTO

# codex を実行する作業ディレクトリ（このPCの「あなた」の文脈）
CODEX_CWD=/Users/nisijimk/claude-dir

# codex 実行体（このPCは npm グローバル版。ChatGPT.app 同梱版ではない）
CODEX_BIN=/Users/nisijimk/.nvm/versions/node/v22.22.0/bin/codex

# codex 1回あたりの最大実行時間（ミリ秒）。超えたら中断する。既定は1時間。
CODEX_TIMEOUT_MS=3600000

# セッション自動更新の閾値。依頼件数か推定文脈量が到達すると、次の依頼前に要約して切り替える。
# CODEX_SESSION_MAX_CONTEXT_TOKENS はcodexの出力からトークン量を取得できた場合のみ働く。
CODEX_SESSION_MAX_REQUESTS=20
CODEX_SESSION_MAX_CONTEXT_TOKENS=200000
# 引き継ぎ要約の最大文字数
CODEX_HANDOFF_MAX_CHARS=3000

# Discord画像添付の上限。PNG・JPEG・WebPのみ対応。
DISCORD_IMAGE_MAX_COUNT=4
DISCORD_IMAGE_MAX_BYTES=10485760
DISCORD_IMAGE_TIMEOUT_MS=15000
